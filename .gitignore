# ===============================================
# PLM Service - Git Ignore Configuration
# ===============================================

# ===== IDE =====
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store

# ===== Backend (Java/Spring Boot) =====
backend/build/
backend/.gradle/
backend/out/
backend/bin/
backend/target/
**/HELP.md
**/.gradle
**/gradle-app.setting
**/.gradletasknamecache

# ===== Frontend (React/Node) =====
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.turbo/
frontend/.next/
frontend/.nuxt/
frontend/.cache/

# ===== Logs =====
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ===== OS =====
Thumbs.db
.DS_Store
*.swp
*.swo
*~

# ===== Environment Variables =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ===== Database =====
*.db
*.sqlite
*.sqlite3

# ===== Uploaded Files =====
backend/uploads/*
!backend/uploads/.gitkeep

# ===== Compiled Files =====
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ===== Temporary Files =====
*.tmp
*.temp
*.bak
*.swp
*.cache

# ===== Test Coverage =====
coverage/
.nyc_output/
*.lcov

