# ===============================================
# PLM Service - Frontend 환경 설정 예시
# ===============================================
#
# 사용법:
# 1. 이 파일을 복사: cp .env.example .env
# 2. .env 파일의 값을 본인 환경에 맞게 수정
#
# 주의: .env 파일은 .gitignore에 포함되어 Git에 업로드되지 않습니다.
# ===============================================

# ===== API 서버 주소 =====
VITE_API_BASE_URL=http://localhost:8080/api

# ===== 개발 서버 포트 =====
VITE_PORT=5173

# ===== 기타 설정 =====
VITE_APP_NAME="PLM Service"
VITE_APP_VERSION="1.0.0"
