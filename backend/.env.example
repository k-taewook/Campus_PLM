# ===============================================
# PLM Service - Backend 환경 설정 예시
# ===============================================
#
# 사용법:
# 1. 이 파일을 복사: cp .env.example .env
# 2. .env 파일의 값을 본인 환경에 맞게 수정
# 3. application.yml에서 환경변수 참조
#
# 주의: .env 파일은 .gitignore에 포함되어 Git에 업로드되지 않습니다.
# ===============================================

# ===== 데이터베이스 설정 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=plmdb_dev
DB_USERNAME=plm_user
DB_PASSWORD=plm_password

# ===== 서버 설정 =====
SERVER_PORT=8080

# ===== JWT 설정 (User 모듈 구현 시 사용) =====
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=86400000  # 24시간 (밀리초)

# ===== 파일 업로드 설정 (File 모듈 구현 시 사용) =====
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=10485760  # 10MB

# ===== 이메일 설정 (Notification 모듈 구현 시 사용) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===== AWS S3 설정 (선택사항) =====
AWS_ACCESS_KEY=your-access-key
AWS_SECRET_KEY=your-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=plm-service-bucket
